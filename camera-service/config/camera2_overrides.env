# Camera 2 overrides (loaded after camera_config.env)
# Keep shared DB/API/auth settings from the base env file.

CAMERA_RTSP_URL=rtsp://admin:CHANGE_ME@192.168.1.101:554/Streaming/Channels/101
CAMERA_NAME=EMB - Porte Droite
CAMERA_LOCATION=EMB - Porte Droite

# Stable profile for single RTX 2080 with two concurrent 4K camera feeds.
FRAME_SKIP=3
MAX_FACES_PER_FRAME=5

# Distinct door identity and controller for camera 2
DOOR_ID=EMB_PORTE_DROITE
DOOR_CONTROL_URL=http://192.168.1.251:5000/controle


# ===================================
# CONFIGURATION CAMÉRA
# ===================================

# Format URL RTSP Caméra Militaire Hikvision:
# rtsp://[nom_utilisateur]:[mot_de_passe]@[ip_camera]:[port]/Streaming/Channels/[canal]
# Canaux communs: 101 (Flux Principal - HD 8MP), 102 (Flux Secondaire - Résolution Inférieure)
CAMERA_RTSP_URL=rtsp://admin:Admin123@192.168.1.240:554/Streaming/Channels/101

# Identification de la caméra
CAMERA_NAME=EMB - Porte Gauche
CAMERA_LOCATION=EMB - Porte Gauche

# ===================================
# VIDEO PROCESSING SETTINGS - OPTIMIZED FOR STABILITY
# ===================================

# Process every Nth frame (LOWER = MORE RELIABLE)
# CRITICAL: For entrance gate, we need to catch EVERY person!
#   1 = Process every frame (most reliable, but CPU intensive)
#   2 = Process every 2nd frame (good balance)
#   3 = Process every 3rd frame (still reliable)
#   5+ = NOT RECOMMENDED - too many missed detections
#
# For a 25 FPS camera:
#   FRAME_SKIP=1 → 25 frames/sec processed
#   FRAME_SKIP=2 → 12.5 frames/sec processed (RECOMMENDED)
#   FRAME_SKIP=3 → 8.3 frames/sec processed
#   FRAME_SKIP=5 → 5 frames/sec processed (TOO LOW - misses people!)
FRAME_SKIP=2

# Camera Resolution (LOWER = FASTER & MORE STABLE)
# CRITICAL: High resolution = slow processing = frame drops!
# Recommended for RTSP streaming:
#   1920x1080 (Full HD) - Good quality, moderate speed
#   1280x720 (HD) - Best balance for face recognition
#   640x480 (SD) - Fastest, but lower quality
#
# For face recognition, 1280x720 is optimal:
#   - Fast enough to process every frame
#   - High enough quality for recognition
#   - Reduces RTSP bandwidth issues
FRAME_WIDTH=4096
FRAME_HEIGHT=2160

# ===================================
# INTÉGRATION COMPREFACE (100% HORS LIGNE!)
# ===================================

# URL API CompreFace (réseau docker interne - PAS D'INTERNET)
COMPREFACE_API_URL=http://compreface-api:8080

# ⚠️ CLÉ API DU SERVICE DE RECONNAISSANCE COMPREFACE
#
# IMPORTANT: Cette clé est générée par VOTRE PROPRE instance CompreFace locale!
# Ce n'est PAS une clé d'internet - tout est 100% hors ligne sur votre serveur.
#
# COMMENT OBTENIR VOTRE CLÉ API:
# 1. Démarrer CompreFace: docker-compose up -d
# 2. Attendre 3 minutes pour l'initialisation
# 3. Ouvrir http://localhost:8000 dans votre navigateur
# 4. Se connecter (ou créer un compte si première fois)
# 5. Aller dans "Applications" → "Créer une Application"
#    - Nom: "Base Principale" 
# 6. Dans l'application → "Services" → Activer "Recognition"
# 7. COPIER la clé API affichée (ex: 00000000-0000-0000-0000-000000000001)
# 8. Coller la clé ci-dessous
# 9. Redémarrer: docker-compose restart 1bip-camera-service
#
# EXEMPLE DE CLÉ: 00000000-0000-0000-0000-000000000001
# Clé API du service "mellal recognition" dans l'app "1°BIP Face Recognition"
COMPREFACE_API_KEY=fe1a4c67-1c6b-49d1-b465-9af4f09ed5ab

# ===================================
# RECOGNITION THRESHOLDS
# ===================================

# Similarity threshold for authorized access (0.0 to 1.0)
# CRITICAL: Balance security vs reliability
#   0.92+ = Very strict - may miss known people (false negatives)
#   0.85-0.90 = Balanced - good for secure entrances (RECOMMENDED)
#   0.75-0.84 = Lenient - higher risk of false positives
#
# For entrance gate with overhead camera: 0.85 is optimal
#   - Accounts for lighting variations
#   - Accounts for angle variations
#   - Still maintains security
SIMILARITY_THRESHOLD=0.91

# Detection probability threshold (0.0 to 1.0)
# CRITICAL: Too high = miss valid detections!
#   0.85+ = Very strict - many false rejections
#   0.70-0.80 = Balanced - reliable detection (RECOMMENDED)
#   0.60-0.69 = Lenient - may include unclear faces
#
# For overhead camera: 0.75 is optimal
#   - Allows slight variations in lighting
#   - Catches faces at various angles
#   - Still maintains quality
DET_PROB_THRESHOLD=0.75

# ===================================
# MILITARY-GRADE QUALITY CONTROL
# ===================================

# Distance-based filtering: Only recognize faces within 3 meters
# Face size at different distances (1920x1080 resolution):
# - 1 meter: ~200-300 pixels wide
# - 2 meters: ~100-150 pixels wide
# - 3 meters: ~70-100 pixels wide

# Minimum face width in pixels (enforces 3-meter maximum distance)
MIN_FACE_WIDTH=70

# Minimum face height in pixels (enforces 3-meter maximum distance)
MIN_FACE_HEIGHT=70

# Minimum face area in pixels² (width × height)
# 70x70 = 4900 pixels² ensures sufficient detail for reliable recognition
MIN_FACE_AREA=4900

# ===================================
# FACE POSE DETECTION (Reject Side Profiles)
# ===================================

# Maximum yaw angle (side rotation) in degrees
# Yaw = turning head left/right
# 30° = Allow slight head turns, reject full side profiles
# Lower = stricter (only frontal faces), Higher = more lenient
MAX_YAW_ANGLE=30

# Maximum pitch angle (up/down tilt) in degrees
# Pitch = looking up/down
# IMPORTANT: Camera Setup Specific Configuration
#   Camera Position: 1m above faces, pointing DOWN at entrance
#
#   What This Detects:
#   ✅ People walking and looking STRAIGHT ahead (pitch ~30-40°)
#   ❌ People looking DOWN at phone (pitch ~60-70°) - REJECTED
#   ❌ Back of head - REJECTED (yaw check)
#   ❌ Side profiles - REJECTED (yaw check)
#
# 45° = Optimal for 1m overhead camera at entrance
# Allows: Normal walking (looking straight)
# Rejects: Looking down, side profiles, back of head
MAX_PITCH_ANGLE=45

# ===================================
# FACE TRACKING & ATTENDANCE DEDUPLICATION
# ===================================

# Track timeout in seconds
# How long to wait before considering same person as "new visit"
# If person disappears for longer than this, they get a new track_id
# Examples:
#   5 = Very short (fast door access - door closes in 3s)
#   10 = Short visits (quick access control)
#   30 = Medium visits (monitoring areas with movement)
TRACK_TIMEOUT=5

# IoU threshold for track matching (0.0 to 1.0)
# How much bounding boxes must overlap to be same person
# 0.3 = 30% overlap required (recommended)
# Lower = tracks can move more, Higher = stricter matching
TRACK_IOU_THRESHOLD=0.3

# Embedding similarity threshold for track matching (0.0 to 1.0)
# Used when same person name is recognized
# 0.6 = 60% embedding similarity (recommended)
TRACK_EMBEDDING_THRESHOLD=0.6

# ===================================
# ALERT CONFIGURATION
# ===================================

# Enable/disable alerts for unauthorized access
ENABLE_ALERTS=true

# Webhook URL for alert notifications
# Example: Slack, Discord, Microsoft Teams, custom endpoint
# Leave empty to disable webhook alerts
ALERT_WEBHOOK_URL=

# Email for alert notifications
# Leave empty to disable email alerts
ALERT_EMAIL=security@1bip.com

# Alert cooldown period in seconds
# Prevents alert spam - won't send another alert within this time
# Recommended: 30-120 seconds
ALERT_COOLDOWN_SECONDS=10

# ===================================
# DATABASE CONFIGURATION
# ===================================

# Paramètres de connexion PostgreSQL
# IMPORTANT: Le mot de passe doit correspondre à celui dans le fichier .env principal
DB_HOST=compreface-postgres-db
DB_PORT=5432
DB_NAME=morocco_1bip_frs
DB_USER=postgres
DB_PASSWORD=admin

# ===================================
# PERFORMANCE SETTINGS
# ===================================

# Maximum faces to detect per frame
# Higher = more CPU usage
# Recommended: 5-10 for entrance gates
MAX_FACES_PER_FRAME=5

# Reconnection delay if camera disconnects (seconds)
RECONNECT_DELAY=5

# ===================================
# RTSP STREAM OPTIMIZATION (CRITICAL FOR STABILITY!)
# ===================================

# RTSP Transport Protocol
# TCP = More reliable, no packet loss, but higher latency
# UDP = Faster, but can drop packets (default for most cameras)
# For entrance gate: TCP is HIGHLY RECOMMENDED
RTSP_TRANSPORT=tcp

# RTSP Buffer Size (frames)
# Smaller buffer = lower latency but more drops
# Larger buffer = higher latency but fewer drops
# For face recognition: 1-2 frames is optimal
RTSP_BUFFER_SIZE=2

# Socket buffer size in bytes (increase to tolerate jitter)
RTSP_BUFFER_SIZE_BYTES=262144

# Allow FFmpeg to wait up to 5 seconds (microseconds) for RTSP packets
RTSP_STIMEOUT=5000000

# Disable ultra-low-latency mode to give decoder reorder room
RTSP_LOW_DELAY=false

# Frame Read Timeout (milliseconds)
# How long to wait for a frame before giving up
# Lower = faster failure detection
# Higher = more patient with slow network
RTSP_TIMEOUT=5000

# ===================================
# CAPTURE RECOVERY (EMPTY FRAME HANDLING)
# ===================================

# Maximum consecutive empty frames before reconnecting
EMPTY_FRAME_MAX_RETRIES=15

# Delay between empty-frame retries (milliseconds)
EMPTY_FRAME_RETRY_DELAY_MS=50

# ===================================
# VIDEO STREAMING OPTIMIZATION
# ===================================

# Stream resolution (lower = faster streaming, but full resolution still used for face recognition)
# Options: 1280x720 (720p - Fast), 1920x1080 (1080p - High Quality), 640x480 (480p - Very Fast)
# Recommended: 1280x720 for optimal balance
STREAM_WIDTH=1280
STREAM_HEIGHT=720

# Enable/disable MJPEG dashboard stream
# Set to false if stream causes lag or bandwidth issues
ENABLE_STREAMING=true

# JPEG quality for streaming (0-100)
# Lower = smaller file size = faster streaming
# Recommended: 50-70 for good balance between quality and speed
STREAM_JPEG_QUALITY=55

# Stream frame rate (FPS)
# Higher = smoother video but more bandwidth
# Recommended: 20-30 for smooth real-time monitoring
STREAM_FPS=12

# ===================================
# DEBUGGING & DEVELOPMENT
# ===================================

# Save images of unauthorized access attempts
# WARNING: This will consume disk space
SAVE_DEBUG_IMAGES=true

# Debug image storage path (inside container)
DEBUG_IMAGE_PATH=/app/logs/debug_images

# ===================================
# RASPBERRY PI DOOR CONTROL
# ===================================

# Enable/disable automatic door control signals
# When enabled, sends HTTP POST to Raspberry Pi when authorized face detected
DOOR_CONTROL_ENABLED=true

# Raspberry Pi door controller URL
# Default: http://192.168.1.250:5000/controle
# The Pi will receive: {"autorise": True}
DOOR_CONTROL_URL=http://192.168.1.94:5000/controle

# Door identifier sent to Raspberry Pi (for multi-door routing)
DOOR_ID=EMB_PORTE_GAUCHE

# HTTP request timeout in seconds
# Recommended: 2-5 seconds to avoid blocking recognition
DOOR_CONTROL_TIMEOUT=2

# ===================================
# MULTIPLE CAMERA SUPPORT
# ===================================
# To run multiple camera instances, copy this file and change:
# - CAMERA_RTSP_URL
# - CAMERA_NAME
# - CAMERA_LOCATION
# Then run multiple docker containers with different config files
